<UserControl x:Class="ArgusShieldDashboard.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
        <StackPanel Margin="14" MinWidth="600">

            <!-- Hero Section -->
            <Border Background="{StaticResource PanelBackground}" BorderBrush="#2a2a2a" BorderThickness="1" CornerRadius="8" Padding="30" Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ArgusShield" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Version 1.0.0" FontSize="18" Foreground="#555" HorizontalAlignment="Center" Margin="0,5"/>
                    <TextBlock Text="Security Against Advanced Injection Attacks" FontSize="14" Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Key Features" FontSize="20" FontWeight="Bold" Foreground="#ddd" Margin="0,0,0,10"/>

            <!-- Features Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- 1 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource CriticalColor}" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Real-time DLL Protection" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="Monitor and block DLL injection attacks as they happen using ETW tracing." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 2 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource HighColor}" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Multi-Layer Scoring" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="Context enrichment, code signing validation, and behavior analysis to reduce false positives." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 3 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="#9b59b6" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Process Monitoring" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="Parent-child relationship analysis and burst detection for injection attempts." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 4 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource AccentColor}" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Code Signing Validation" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="WinVerifyTrust checks to distinguish trusted publishers from unknown binaries." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 5 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource LowColor}" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Lightweight Operation" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="Background service with minimal CPU and memory footprint." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- 6 -->
                <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource HighColor}" BorderThickness="0,3,0,0" CornerRadius="8" Padding="16,14" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Threat Blocking" FontSize="14" FontWeight="Bold" Foreground="#eee" Margin="0,0,0,6"/>
                        <TextBlock Text="Automatic termination of injector processes when score exceeds threshold." FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Credits -->
            <GroupBox Header="Credits" Style="{DynamicResource InnerBoxStyle}" Background="{StaticResource PanelBackground}" BorderBrush="#2a2a2a" Foreground="#888" BorderThickness="1" Padding="12,15,12,12" FontSize="13" FontWeight="Bold">
                <TextBlock Foreground="#888" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                    Developed as a Final Year Project.<LineBreak/>
                    Built with ETW (Event Tracing for Windows), C# Windows Services, and WPF.<LineBreak/>
                    MITRE ATT&amp;CK Framework: T1055.001 (Process Injection: DLL Injection)
                </TextBlock>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>

</UserControl>
